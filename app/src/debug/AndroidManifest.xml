        android:targetPackage="${applicationId}" android:label="Delos SGSR GPU checks" />
    <instrumentation android:name="com.limelight.binding.video.PyroWaveGpuInstrumentation"
        android:targetPackage="${applicationId}" android:label="Delos PyroWave Vulkan GPU checks" />
    <instrumentation android:name="com.limelight.shell.ui.IconFontInstrumentation"
        android:targetPackage="${applicationId}" android:label="Delos icon centering checks" />
</manifest>
