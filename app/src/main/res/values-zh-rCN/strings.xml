    <string name="category_advanced_settings">高级设置</string>
    <string name="title_unlock_fps">解锁所有可用帧率</string>
    <string name="summary_unlock_fps">以 90 或 120 FPS 串流可能降低高端设备的延迟，但在不支持的设备上可能导致卡顿或不稳定</string>
    <string name="title_checkbox_reduce_refresh_rate">允许降低刷新率</string>
    <string name="summary_checkbox_reduce_refresh_rate">降低显示刷新率可以省电，但会增加一些视频延迟</string>
    <string name="title_checkbox_disable_warnings">禁用警告消息</string>
