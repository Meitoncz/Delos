    <string name="title_resolution_list">视频分辨率</string>
    <string name="summary_resolution_list">调高可提升画面清晰度；调低可在低端设备和较慢的网络上获得更好的性能。</string>
    <string name="title_fps_list">视频帧率</string>
    <string name="summary_fps_list">调高可使视频串流更流畅；调低可在低端设备上获得更好的性能。</string>
    <string name="title_seekbar_bitrate">视频码率</string>
    <string name="summary_seekbar_bitrate">调高可提升画质；调低可改善较慢连接下的性能。</string>
    <string name="title_seekbar_metered_bitrate">计费网络下的视频码率</string>
    <string name="summary_seekbar_metered_bitrate">高码率会消耗更多流量，在计费网络中降低码率可提升流畅度。\n设为 0 则使用上述码率设置的 1/4。</string>
    <string name="suffix_seekbar_bitrate_mbps">Mbps</string>
    <string name="title_resolution_scale_factor">分辨率缩放系数</string>
    <string name="summary_resolution_scale_factor">服务器端请求的虚拟屏幕分辨率将乘以此系数，不影响串流分辨率。\n例如：120% 会使 2000x1000 变为 2400x1200。\n设置更高的缩放系数可提升部分游戏的画质。\n需要 Apollo 才能生效。</string>
    <string name="title_checkbox_auto_invert_video_resolution">自动翻转分辨率</string>
    <string name="summary_checkbox_auto_invert_video_resolution">竖屏模式下自动对调视频串流的宽度和高度。\n例如：1920x1080 将变为 1080x1920。</string>
    <string name="title_video_scale_mode">视频缩放模式</string>
    <string name="summary_video_scale_mode">在适应、填充和拉伸之间选择</string>
    <string name="video_scale_mode_fit">适应</string>
    <string name="video_scale_mode_fill">填充</string>
    <string name="video_scale_mode_stretch">拉伸</string>

    <string name="category_audio_settings">音频设置</string>
    <string name="title_audio_config_list">环绕声配置</string>
    <string name="summary_audio_config_list">为家庭影院系统启用 5.1 或 7.1 环绕声</string>
    <string name="title_checkbox_enable_audiofx">启用系统均衡器支持</string>
    <string name="summary_checkbox_enable_audiofx">允许音效在串流时生效，但可能增加音频延迟</string>

    <string name="category_gamepad_settings">手柄设置</string>
    <string name="title_checkbox_multi_controller">自动检测手柄是否存在</string>
    <string name="summary_checkbox_multi_controller">取消勾选此项将强制始终存在一个手柄</string>
    <string name="title_checkbox_vibrate_fallback">用设备震动模拟手柄震动</string>
    <string name="summary_checkbox_vibrate_fallback">当手柄不支持震动时，通过设备震动来模拟</string>
    <string name="title_seekbar_vibrate_fallback_strength">调整模拟震动强度</string>
    <string name="summary_seekbar_vibrate_fallback_strength">增强或减弱设备的震动强度</string>
    <string name="suffix_seekbar_vibrate_fallback_strength">%</string>
    <string name="title_seekbar_deadzone">调整摇杆死区</string>
    <string name="summary_seekbar_deadzone">正值设置常规死区，负值应用死区补偿。使用死区补偿时，请确保手柄可以调整死区，否则可能难以回中。</string>
    <string name="suffix_seekbar_deadzone">%</string>
    <string name="title_checkbox_xb1_driver">Xbox 360/One/Nintendo Pro USB 手柄驱动</string>
    <string name="summary_checkbox_xb1_driver">为不原生支持 Xbox/Nintendo Pro 手柄的设备启用内置 USB 驱动</string>
    <string name="title_checkbox_usb_bind_all">覆盖原生 Xbox 手柄支持</string>
    <string name="summary_checkbox_usb_bind_all">对所有受支持的手柄使用 Delos USB 驱动，即使系统已原生支持 Xbox/Nintendo Pro 手柄</string>
    <string name="title_checkbox_mouse_emulation">通过手柄模拟鼠标</string>
    <string name="summary_checkbox_mouse_emulation">长按 Start 键可在手柄和鼠标模式之间切换</string>
    <string name="title_checkbox_remember_mouse_mode">记住鼠标模式</string>
    <string name="summary_checkbox_remember_mouse_mode">记住串流期间选择的鼠标模式。关闭后，串流期间更改的鼠标模式仅为临时生效。</string>
    <string name="title_checkbox_flip_face_buttons">交换面键</string>
    <string name="summary_checkbox_flip_face_buttons">为手柄和屏幕按键交换面键 A/B 和 X/Y</string>
    <string name="title_checkbox_gamepad_touchpad_as_mouse">始终用触控板控制鼠标</string>
    <string name="summary_checkbox_gamepad_touchpad_as_mouse">强制手柄触控板输入控制 PC 鼠标，即使在模拟带触控板的手柄时也是如此。</string>
    <string name="title_checkbox_gamepad_motion_sensors">外接手柄陀螺仪</string>
    <string name="summary_checkbox_gamepad_motion_sensors">允许 PC 读取已连接的外接手柄的陀螺仪和加速度计（如果有）。需要 Android 12 或更高版本。如果没有应用使用体感，可将其关闭，以略微节省电量和网络流量。</string>
    <string name="title_checkbox_gamepad_motion_fallback">设备内置陀螺仪</string>
    <string name="summary_checkbox_gamepad_motion_fallback">当已连接的手柄没有陀螺仪，或你的 Android 版本无法读取时，使用此设备自带的陀螺仪和加速度计（掌机的内置传感器）。\n注意：此时 PC 可能会将你的手柄识别为 PlayStation 手柄。</string>
    <string name="title_checkbox_force_device_motion">始终使用设备内置陀螺仪</string>
    <string name="summary_checkbox_force_device_motion">即使外接手柄报告其传感器可用，也使用设备自带的传感器。</string>
    <string name="title_seekbar_gyro_smoothing">陀螺仪平滑</string>
    <string name="summary_seekbar_gyro_smoothing">在陀螺仪数据发送到 PC 之前对其进行稳定处理。0 为关闭；数值越高，抖动消除越多，但慢速瞄准会增加少许延迟。快速甩动仍保持灵敏。对下次串流生效；串流菜单（更多）可实时调整。</string>
    <string name="suffix_seekbar_gyro_smoothing">%</string>
    <string name="title_enable_rumble">启用震动</string>
    <string name="summary_enable_rumble">在受支持的手柄上启用震动反馈。</string>
    <string name="category_input_settings">输入设置</string>
    <string name="title_checkbox_absolute_mouse_mode">远程桌面鼠标模式</string>
    <string name="summary_checkbox_absolute_mouse_mode">这可以让鼠标加速在远程桌面使用时更自然，但与许多游戏不兼容。</string>
    <string name="title_checkbox_mouse_nav_buttons">启用鼠标前进/后退键</string>
    <string name="summary_checkbox_mouse_nav_buttons">启用此选项可能导致部分有缺陷的设备无法使用右键</string>

