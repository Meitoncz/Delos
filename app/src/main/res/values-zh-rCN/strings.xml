    <string name="title_pyrowave_chroma">PyroWave 色度</string>
    <string name="summary_pyrowave_chroma">PyroWave 视频的色度分辨率。4:4:4 可保留完整的色彩细节，但需要更多带宽和 GPU 时间，且需要 PC 端支持；否则串流将使用 4:2:0。开启 HDR 时不可选。</string>
    <string name="pyrowave_chroma_420">4:2:0（默认）</string>
    <string name="pyrowave_chroma_444">4:4:4</string>

    <string name="title_frame_pacing">帧节奏</string>
    <string name="summary_frame_pacing">指定如何在视频延迟和流畅度之间取得平衡。Warp Drive 和 Warp 2 可能并非在所有设备上都能工作。</string>
    <string name="pacing_warp">Warp Drive</string>
    <string name="pacing_warp2">Warp 2</string>
    <string name="pacing_latency">最低延迟</string>
    <string name="pacing_balanced">均衡</string>
    <string name="pacing_balanced_alt">均衡（带 FPS 限制）</string>
    <string name="pacing_smoothness">最流畅</string>
    <string name="pacing_fast_vsync">快速 V-Sync (Nano Pacer)</string>

    <string name="title_async_decode">异步解码</string>
    <string name="summary_async_decode">MediaCodec 通过回调而非轮询来提供就绪的缓冲区。适用于 H.264、HEVC 和 AV1；对下次串流生效。如果解码器不够稳定，请将其关闭。</string>
    <string name="title_sgsr">骁龙游戏超分辨率</string>
    <string name="summary_sgsr">使用 SGSR 1 对较低分辨率的视频进行超分。需要 OpenGL ES 3.1；HDR 在支持的情况下使用十位 P010 输出。可在串流菜单中实时切换。PyroWave 使用其自己的渲染器。请选择低于屏幕分辨率的串流分辨率。</string>
    <string name="title_sgsr_quality">超分模式</string>
    <string name="summary_sgsr_quality">SGSR 1（高通）对当前帧进行滤波。SGSR2-DV 是 Delos 针对视频的 SGSR 2 版本：它通过光流检测运动，并复用之前帧中的细节。“仅锐化”只在串流尺寸上进行锐化。HDR 和实时切换在所有模式下均可用。</string>
    <string name="title_sgsr_sharpness">超分锐度</string>
    <string name="summary_sgsr_sharpness">锐化强度，范围 0 到 100。0 表示禁用锐化。在 SGSR 模式下，它是独立的最终处理步骤，不会改变重建结果；在“仅锐化”模式下，它就是全部效果。可实时调整。</string>
    <string name="title_sgsr_supersampling_level">超采样质量</string>
    <string name="summary_sgsr_supersampling_level">当串流分辨率已与屏幕一致时的内部尺寸：以 1080p 串流为例，为 2560 x 1440（1.33 倍）或 3840 x 2160（2 倍）。2 倍需要更多 GPU 时间和内存，放不下时会回退到 1.33 倍。可在串流菜单中实时更改。</string>
    <string name="sgsr_supersampling_level_1">1.33×（1440p）</string>
    <string name="sgsr_supersampling_level_2">2×（2160p）</string>
    <string name="sgsr_quality_standard">SGSR 1（标准）</string>
    <string name="sgsr_quality_high">SGSR 1（画质）</string>
    <string name="sgsr_quality_temporal">SGSR2-DV（标准）</string>
    <string name="sgsr_quality_temporal_quality">SGSR2-DV（画质）</string>
    <string name="sgsr_quality_sharpen">仅锐化</string>


    <string name="keyboard_service_label">Delos 实体键盘</string>
    <string name="accessibility_description_text">仅在实体键盘快捷键被系统拦截时使用。在某些系统中，部分键盘快捷键由 Android 系统定义并占用，导致无法传递到 PC。Delos 不会查看你的输入，也不会收集你的密码、信用卡号或任何其他私人信息。</string>


