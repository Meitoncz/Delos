    <string name="title_video_format">视频编解码器</string>
    <string name="summary_video_format">如果设备支持，较新的编解码器可以降低视频带宽需求。如果 PC 端软件或 GPU 不支持，所选编解码器可能被忽略。</string>
    <string name="title_enable_hdr">启用 HDR</string>
    <string name="summary_enable_hdr">当应用和 PC 的 GPU 支持时串流 HDR。HDR 需要支持 HEVC Main 10 编码的 GPU。HDR 的显示效果取决于此设备的屏幕。</string>
    <string name="title_full_range">强制全范围视频</string>
    <string name="summary_full_range">如果你的设备无法正确显示全范围视频内容，这会导致亮部和暗部细节丢失。</string>
    <string name="title_prevent_packet_loss">Wi-Fi 保活</string>
    <string name="summary_prevent_packet_loss">串流期间发送小数据包，帮助 Wi-Fi 避免进入省电模式。可能对出现不明丢包的设备有帮助。</string>
    <string name="title_enable_perf_overlay">串流时显示性能统计</string>
    <string name="summary_enable_perf_overlay">串流时显示实时的串流性能信息</string>

