        <item quantity="other">%1$s，%2$s 行日志</item>
    </plurals>
    <string name="debug_log_reading">正在读取…</string>
    <string name="debug_log_off">关闭</string>
    <string name="debug_log_description">Delos 在此设备上保留的事件和错误，已去除地址和名称。分享时发送的就是这些内容。</string>
    <string name="debug_log_preview_reading">正在读取日志…</string>
    <string name="debug_share_label">分享诊断日志</string>
    <string name="debug_share_description">用预览中显示的文本打开 Android 分享面板。选择应用之前不会发送任何内容。</string>
    <string name="debug_copy_label">复制诊断摘要</string>
    <string name="debug_copy_description">复制设备信息块和最近 100 行日志，可直接粘贴到问题反馈中。同样会去除名称和地址。</string>
    <string name="debug_clear_label">清除诊断日志</string>
    <string name="debug_clear_description">删除此设备上的日志。除非关闭“保留诊断日志”（设置 > 关于），否则新事件仍会继续记录。</string>

    <string name="debug_vibrators_label">震动马达数量</string>
    <string name="debug_vibrators_single">1（单个）</string>
    <string name="debug_vibrators_description">系统报告的震动马达数量。为 1 表示所有预设都驱动同一个马达。</string>
    <string name="debug_amplitude_label">振幅控制</string>
    <string name="debug_amplitude_description">震动马达是否可以调节强度。</string>
    <string name="debug_last_problem_label">最近的问题</string>
    <string name="debug_last_problem_description">显示最近播放的预设无法使用其技术、改为播放普通振幅路径的情况及原因。</string>

    <string name="debug_vibrate_once_label">震动一次</string>
    <string name="debug_vibrate_once_description">全力震动一秒。</string>
    <string name="debug_continuous_label">持续震动</string>
    <string name="debug_continuous_description">按下方强度持续震动，直到关闭或离开此界面。</string>
    <string name="debug_strength_label">强度</string>
    <string name="debug_strength_description">持续震动的强度，1–255，适用于设备和手柄。</string>

    <string name="debug_preset_custom">自定义</string>
    <string name="debug_mode_translator_on">%1$s · 转换器开启</string>
    <string name="debug_mode_translator_off">%1$s · 转换器关闭</string>
    <string name="debug_preset_label">当前预设</string>
    <string name="debug_preset_description">在下方选择一个预设即可保存，并立即播放测试样本。</string>
    <string name="debug_preset_details">模式：%1$s\n高级选项的修改会保存为自定义，即使数值与某个预设一致。</string>
    <string name="debug_preset_problem">有问题</string>
    <string name="debug_preset_problem_description">%1$s 问题：%2$s。</string>
    <string name="debug_preset_active">使用中</string>
    <string name="debug_preset_select">选择</string>
    <string name="debug_live_amplitude_label">实时振幅 · %1$s</string>
    <string name="debug_live_amplitude_description">实时计算的设备振幅，包含起振冲击和逐渐稳定的平滑过程。</string>
    <string name="debug_live_amplitude_details">模式：%1$s\n波形：%2$s\n电脑的两个马达都会收到所标注的输入百分比；这不是最终输出百分比。</string>
    <string name="debug_stop_label">停止震动</string>
    <string name="debug_stop_description">停止实验室波形以及所有持续的设备/手柄震动测试。</string>
    <string name="debug_replay_label">重播测试样本</string>

    <string name="debug_pattern_details">实时振幅：%1$d / 255\n模式：%2$s\n正在播放：%3$s\n输入值为电脑马达的百分比，而非设备最终输出。选择其他波形可替换当前波形，或点击停止震动。</string>
    <string name="debug_pattern_test_label">测试</string>
    <string name="debug_pattern_test_description">一次短促轻敲、一秒稳定震动、一段渐强上升和一次逐渐衰减的爆炸。</string>
    <string name="debug_pattern_steady_25_label">稳定 25% · 怠速引擎</string>
    <string name="debug_pattern_steady_25_description">两秒低沉的引擎震动，电脑两个马达均为 25%。</string>
    <string name="debug_pattern_steady_50_label">稳定 50% · 巡航引擎</string>
    <string name="debug_pattern_steady_50_description">两秒中等强度的引擎震动，电脑两个马达均为 50%。</string>
    <string name="debug_pattern_steady_75_label">稳定 75% · 崎岖路面</string>
    <string name="debug_pattern_steady_75_description">两秒强烈的路面震动，电脑两个马达均为 75%。</string>
    <string name="debug_pattern_steady_100_label">稳定 100% · 最大力度</string>
    <string name="debug_pattern_steady_100_description">两秒最大强度的电脑震动，两个马达均为 100%。</string>
    <string name="debug_pattern_ramp_label">渐强 · 加速</string>
    <string name="debug_pattern_ramp_description">电脑两个马达在两秒内从静止升至满输入。</string>
    <string name="debug_pattern_tap_30_label">30 ms 轻敲 · 轻微撞击</string>
    <string name="debug_pattern_tap_30_description">四次满输入的 30 ms 轻敲，间隔 250 ms 静默。</string>
    <string name="debug_pattern_tap_60_label">60 ms 轻敲 · 武器开火</string>
    <string name="debug_pattern_tap_60_description">四次满输入的 60 ms 轻敲，间隔 250 ms 静默。</string>
    <string name="debug_pattern_tap_100_label">100 ms 轻敲 · 重击</string>
    <string name="debug_pattern_tap_100_description">四次满输入的 100 ms 轻敲，间隔 250 ms 静默。</string>
    <string name="debug_pattern_heartbeat_label">心跳 · 成对脉冲</string>
    <string name="debug_pattern_heartbeat_description">四组 70 ms / 100 ms 的满输入脉冲，如同心跳。</string>
    <string name="debug_pattern_explosion_label">爆炸 · 衰减冲击</string>
    <string name="debug_pattern_explosion_description">满输入的冲击，在两秒内衰减至静默。</string>
    <string name="debug_pattern_flutter_label">颤动 · 高速机械</string>
    <string name="debug_pattern_flutter_description">二十次满输入的 20 ms 脉冲，每次之后静默 40 ms。</string>

    <string name="debug_advanced_label">高级</string>
    <string name="debug_advanced_description">显示手动控制项。修改数值会将预设标记为自定义，并停止当前波形。</string>
    <string name="debug_enabled_label">启用震动转换器</string>
    <string name="debug_enabled_description">关闭时使用原始转换。开启时，将这些参数应用于串流震动和实验室波形。</string>
    <string name="debug_gain_label">增益</string>
    <string name="debug_gain_description">整体震动倍率，50–300%。更改参数会停止当前波形。</string>
    <string name="debug_curve_label">曲线</string>
    <string name="debug_curve_description">响应指数：低于 %1$d%% 会增强微弱震动；高于 %1$d%% 会减弱震动。</string>
    <string name="debug_min_label">最小振幅</string>
    <string name="debug_min_description">电脑请求非零震动时的最小输出。输入为零时保持静默。</string>
    <string name="debug_kick_label">起振冲击</string>
    <string name="debug_kick_description">从静止开始先以全力冲击，再逐渐稳定到转换后的振幅。</string>
    <string name="debug_low_label">低频马达权重</string>
    <string name="debug_low_description">电脑低频马达对设备单个震动马达的贡献。原始值：80%。</string>
    <string name="debug_high_label">高频马达权重</string>
    <string name="debug_high_description">电脑高频马达对设备单个震动马达的贡献。原始值：33%。</string>
    <string name="debug_smoothing_label">平滑</string>
    <string name="debug_smoothing_description">限制振幅的快速变化。为零时立即响应；数值越高，稳定得越慢。</string>
    <string name="debug_reset_label">将参数重置为原始值</string>
    <string name="debug_reset_description">将原始参数恢复为自定义。启用开关保持不变。</string>

    <string name="debug_osc_label">预览屏幕按键</string>
    <string name="debug_osc_description">不串流也能使用你的屏幕按键：试试每个按键、方向键和摇杆，不会发送任何内容。角落的齿轮可编辑布局，与串流中一致。</string>

    <string name="debug_no_pads_label">未连接手柄</string>
    <string name="debug_no_pads_description">连接手柄后会立即显示在这里。掌机的内置按键算作一个手柄。</string>
    <string name="debug_pad_description_vibrates">厂商与产品 ID %1$s（%2$s）。运动传感器：%3$s。震动：支持，选择即可测试。</string>
    <string name="debug_pad_description_silent">厂商与产品 ID %1$s（%2$s）。运动传感器：%3$s。震动：不支持。</string>
    <string name="debug_sensors_unknown">Android 12 以下未知</string>
    <string name="debug_sensors_none">未报告</string>
    <string name="debug_sensors_accelerometer">加速度计</string>
    <string name="debug_sensors_gyroscope">陀螺仪</string>
    <string name="debug_sensors_both">加速度计、陀螺仪</string>
    <string name="debug_pads_continuous_label">手柄持续震动</string>
    <string name="debug_pads_continuous_description">所有支持震动的手柄都会按上方强度持续震动。</string>
</resources>
