<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Toasts and short messages that belong to no single screen -->
    <!-- %1$s: file name -->
    <string name="shell_report_saved">Log saved to Downloads as %1$s. Attach it to the issue.</string>
    <string name="shell_report_save_failed">The log could not be saved. Share it from Settings → About → Debug info.</string>
    <string name="shell_report_no_browser">No browser is available</string>
    <!-- %1$s: PC name -->
    <string name="shell_retry_unreachable">%1$s cannot be reached</string>
    <!-- %1$s: game name, %2$s: PC name -->
    <string name="shell_retry_game_missing">%1$s is not available on %2$s</string>
    <!-- %1$s: PC name; the game name is not known -->
    <string name="shell_retry_game_missing_unnamed">The app is not available on %1$s</string>
    <string name="shell_profile_updated">Profile updated</string>
    <!-- %1$s: profile name -->
    <string name="shell_welcome">Welcome, %1$s</string>
    <!-- %1$s: PC name -->
    <string name="shell_game_unreachable">%1$s cannot be reached</string>
    <!-- %1$s: PC name -->
    <string name="shell_game_virtual_display_missing">The virtual display is not ready on %1$s · streaming the main display</string>
    <!-- %1$s: game name -->
    <string name="shell_game_quitting">Quitting %1$s…</string>

    <!-- The small word above a toast: the kind of the message. Written in capitals where the script has them -->
    <string name="toast_kind_info">INFO</string>
    <string name="toast_kind_success">DONE</string>
    <string name="toast_kind_warning">WARNING</string>
    <string name="toast_kind_error">ERROR</string>
    <string name="toast_kind_action">UNDO</string>
    <!-- Screen-reader text of a toast. %1$s: the kind word, %2$s: the message -->
    <string name="toast_description">%1$s. %2$s</string>
    <!-- %1$s: the kind word, %2$s: the message, %3$s: the label of the toast's action button -->
    <string name="toast_description_action">%1$s. %2$s. %3$s</string>
</resources>
