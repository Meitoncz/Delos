<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Prefix of the short name of a PC whose own name is too long for the companion panel ("PC · 7C2A") -->
    <string name="companion_flow_pc">PC</string>
    <!-- Title of the companion's loader page; %1$s is the name of the game -->
    <string name="companion_flow_starting">Starting %1$s</string>
    <!-- Title of the loader page when the game's name is too long for the title -->
    <string name="companion_flow_starting_generic">Starting the game</string>
    <!-- Line under the loader's title: %1$s is the PC, %2$s the stream settings that were asked for ("1920 × 1080 · HEVC · 120 FPS") -->
    <string name="companion_flow_requested">%1$s · requested %2$s</string>
    <!-- A step of the loader's list, done -->
    <string name="companion_flow_step_host">Host found</string>
    <!-- A step of the loader's list -->
    <string name="companion_flow_step_launch">Launch request accepted</string>
    <!-- A step of the loader's list -->
    <string name="companion_flow_step_video">Waiting for video</string>
    <!-- The last step of the loader's list -->
    <string name="companion_flow_step_ready">Stream ready</string>
    <!-- A step that has not started yet; %1$s is the step's name -->
    <string name="companion_flow_step_pending">%1$s · pending</string>
    <!-- A step with more steps folded into it on a short panel; %1$s is the step's name, %2$d how many steps are still pending -->
    <string name="companion_flow_step_more">%1$s · +%2$d pending</string>
    <!-- Under the loader's steps: the app does not know how far along the start is -->
    <string name="companion_flow_no_percentage">No completion percentage is known.</string>
    <!-- Touch button of the loader page -->
    <string name="companion_flow_cancel_start">Cancel stream start</string>
    <!-- Title of a waiting page when the shell's own title is too long for it -->
    <string name="companion_flow_wait">Please wait</string>
    <!-- Title of the result page when the shell's own title is too long for it -->
    <string name="companion_flow_result_title">Stream ended</string>
    <!-- Touch button of the result page -->
    <string name="companion_flow_reconnect">Reconnect</string>
    <!-- Result page: what to do after the connection was lost. The app cannot know whether the game stopped, only the host does -->
    <string name="companion_flow_lost_guidance">The game may still be running on the host. Reconnect to resume when available.</string>
    <!-- Short form of the previous text, for small panels -->
    <string name="companion_flow_lost_short">The game may still be running.</string>
    <!-- Result page: what to do after the PC ended the stream; the app does not claim the game stopped -->
    <string name="companion_flow_closed_guidance">Open the library to check whether the game is still running.</string>
    <!-- Short form of the previous text, for small panels -->
    <string name="companion_flow_closed_short">Check the library for the game’s state.</string>
    <!-- Title of the companion page of a stream that could not start -->
    <string name="companion_flow_problem_title">Connection problem</string>
    <!-- Used when even the first sentence of the real error is too long for the companion panel -->
    <string name="companion_flow_error_short">The stream could not start.</string>
    <!-- What to do after a failed start, shown in the accent color -->
    <string name="companion_flow_recovery">Check the host service, firewall and network. Then try again.</string>
    <!-- Short form of the previous text, for small panels -->
    <string name="companion_flow_recovery_short">Check the host service and network.</string>
    <!-- Under the error text on tall companion panels -->
    <string name="companion_flow_full_on_main">The full error remains on the main display.</string>
    <!-- Short form of the report card's note on small companion panels -->
    <string name="companion_flow_report_short">Report opens GitHub with a draft to check.</string>
</resources>
