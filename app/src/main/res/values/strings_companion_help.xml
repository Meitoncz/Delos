<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Small line under the game's name on the companion's game card; the PC's name follows after a dot -->
    <string name="companion_game_focused">Focused app</string>
    <!-- Same line while the focused game runs on the PC -->
    <string name="companion_game_running">Running now</string>
    <!-- Button of the companion's game card while another game runs on the PC: go back to that one -->
    <string name="companion_game_resume_other">Resume other</string>
    <!-- Button of the companion's game card while another game runs on the PC: quit that one and start this one -->
    <string name="companion_game_quit_start">Quit and start</string>
    <!-- Small line under the title of a setting on the companion; %1$s is the name of the settings tab (Display, Stream, ...) -->
    <string name="companion_help_settings_section">Settings · %1$s</string>
    <!-- Button that shows the previous page of a long list on the companion (the list never scrolls) -->
    <string name="companion_pager_previous">Previous</string>
    <!-- Button that shows the next page of a long list on the companion -->
    <string name="companion_pager_next">Next</string>
    <!-- Shorter form of the keyboard's empty-echo hint, for a narrow panel -->
    <string name="companion_typing_hint_short">Tap the keys.</string>
    <plurals name="companion_genres_more">
        <item quantity="one">+%1$d genre</item>
        <item quantity="other">+%1$d genres</item>
    </plurals>
    <plurals name="companion_details_more">
        <item quantity="one">+%1$d line</item>
        <item quantity="other">+%1$d lines</item>
    </plurals>
    <plurals name="companion_typing_count">
        <item quantity="one">%1$d character entered</item>
        <item quantity="other">%1$d characters entered</item>
    </plurals>
</resources>
