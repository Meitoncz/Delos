        <item quantity="other">%1$d of %2$d apps match.</item>
    </plurals>
    <plurals name="companion_filter_games_all">
        <item quantity="one">All %1$d app.</item>
        <item quantity="other">All %1$d apps.</item>
    </plurals>
    <plurals name="companion_filter_images_of">
        <item quantity="one">%1$d of %2$d image matches.</item>
        <item quantity="other">%1$d of %2$d images match.</item>
    </plurals>
    <plurals name="companion_filter_images_all">
        <item quantity="one">All %1$d image.</item>
        <item quantity="other">All %1$d images.</item>
    </plurals>
    <plurals name="companion_filter_images_some">
