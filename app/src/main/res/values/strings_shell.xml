    <string name="shell_progress_count">%1$d of %2$d</string>

    <!-- Note on the left of the hint bar on the home screen. %1$d: apps shown, %2$s: PC name -->
    <plurals name="shell_home_apps_on_pc">
        <item quantity="one">%1$d app on %2$s</item>
        <item quantity="other">%1$d apps on %2$s</item>
    </plurals>
    <!-- A filter is active. %1$d: apps shown, %2$d: apps in the library (the quantity), %3$s: PC name -->
    <plurals name="shell_home_apps_filtered">
        <item quantity="one">%1$d of %2$d app on %3$s</item>
        <item quantity="other">%1$d of %2$d apps on %3$s</item>
    </plurals>
