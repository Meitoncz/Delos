<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The shell: links from outside, the side menu, the bottom hint bar, the report card, button capture, row widgets -->

    <!-- Security prompt for a pairing link opened from another app or a web page. %1$s: the PC (name and address, or just the address) -->
    <string name="shell_link_pair_title">Pair with %1$s?</string>
    <string name="shell_link_pair_message">A link asks Delos to pair with this PC. Continue only if you opened it yourself.</string>
    <string name="shell_link_pair_action">Pair</string>
    <!-- Security prompt for a link that starts a game. %1$s: game name, %2$s: PC name; the variants cover a missing name -->
    <string name="shell_link_start_title">Start %1$s?</string>
    <string name="shell_link_start_title_unnamed">Start an app?</string>
    <string name="shell_link_start_message">A link asks Delos to start %1$s on %2$s. Continue only if you opened it yourself.</string>
    <string name="shell_link_start_message_game">A link asks Delos to start %1$s on a PC. Continue only if you opened it yourself.</string>
    <!-- %1$s: PC name; the game name is not known -->
    <string name="shell_link_start_message_host">A link asks Delos to start an app on %1$s. Continue only if you opened it yourself.</string>
    <string name="shell_link_start_message_unnamed">A link asks Delos to start an app on a PC. Continue only if you opened it yourself.</string>
    <string name="shell_link_start_action">Start</string>

    <!-- The three buttons of the top bar -->
    <string name="shell_nav_settings">Settings</string>
    <string name="shell_nav_profile">Profile</string>
    <string name="shell_nav_devices">Devices</string>
    <!-- The name of the profile created for a user who skips the first-run steps -->
