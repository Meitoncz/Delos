    <string name="debug_share_no_app_toast">로그를 공유할 수 있는 앱이 없어요</string>
    <string name="debug_summary_copied_toast">진단 요약을 복사했어요</string>
    <string name="debug_logs_cleared_toast">진단 로그를 삭제했어요</string>
    <string name="debug_no_motor_toast">이 기기에는 진동 모터가 없어요</string>
    <string name="debug_pad_no_vibration_toast">%1$s은(는) 진동할 수 없어요</string>

    <string name="debug_android_description">이 기기의 Android 버전과 API 레벨이에요.</string>
    <string name="debug_kernel_label">커널</string>
    <string name="debug_kernel_description">Linux 커널 버전이에요.</string>
    <string name="debug_model_label">기기</string>
    <string name="debug_model_description">제조사와 모델이에요.</string>
    <string name="debug_model_details">보드: %1$s\n하드웨어: %2$s\nSoC: %3$s\n빌드: %4$s</string>
    <string name="debug_soc_unknown">알 수 없음</string>
    <string name="debug_motor_label">진동 모터</string>
    <string name="debug_motor_yes_description">이 기기는 진동할 수 있어요.</string>
    <string name="debug_motor_no_description">이 기기에는 진동 모터가 없어요.</string>

    <string name="debug_log_label">진단 로그</string>
    <plurals name="debug_log_size">
        <item quantity="other">%1$s, 로그 %2$s줄</item>
    </plurals>
    <string name="debug_log_reading">읽는 중…</string>
    <string name="debug_log_off">꺼짐</string>
    <string name="debug_log_description">주소와 이름을 제거하고 Delos가 이 기기에 보관한 이벤트와 오류예요. 공유를 누르면 이 내용이 전송돼요.</string>
    <string name="debug_log_preview_reading">로그를 읽는 중…</string>
    <string name="debug_share_label">진단 로그 공유</string>
    <string name="debug_share_description">미리보기에 표시된 텍스트로 Android 공유 시트를 열어요. 앱을 선택하기 전에는 아무것도 전송되지 않아요.</string>
    <string name="debug_copy_label">진단 요약 복사</string>
    <string name="debug_copy_description">기기 정보와 마지막 로그 100줄을 복사해서 이슈에 바로 붙여넣을 수 있게 해요. 같은 이름과 주소가 제거돼요.</string>
    <string name="debug_clear_label">진단 로그 삭제</string>
    <string name="debug_clear_description">이 기기의 로그를 삭제해요. 진단 로그 보관(설정 → 정보)이 꺼져 있지 않으면 새 이벤트는 다시 기록돼요.</string>

    <string name="debug_vibrators_label">진동기</string>
    <string name="debug_vibrators_single">1개 (단일)</string>
    <string name="debug_vibrators_description">시스템이 보고하는 진동기 개수예요. 1개면 모든 프리셋이 같은 모터를 구동해요.</string>
    <string name="debug_amplitude_label">진폭 제어</string>
    <string name="debug_amplitude_description">진동기가 세기를 바꿀 수 있는지 여부예요.</string>
    <string name="debug_last_problem_label">마지막 문제</string>
    <string name="debug_last_problem_description">마지막으로 재생한 프리셋이 자체 기법을 쓰지 못하고 기본 진폭 방식으로 재생된 경우 그 이유를 보여 줘요.</string>

    <string name="debug_vibrate_once_label">한 번 진동</string>
    <string name="debug_vibrate_once_description">최대 세기로 1초 동안 진동해요.</string>
    <string name="debug_continuous_label">연속 진동</string>
    <string name="debug_continuous_description">끄거나 이 화면을 나갈 때까지 아래 세기로 계속 진동해요.</string>
    <string name="debug_strength_label">세기</string>
    <string name="debug_strength_description">기기와 컨트롤러의 연속 진동 세기로, 1–255예요.</string>

    <string name="debug_preset_custom">사용자 지정</string>
    <string name="debug_mode_translator_on">%1$s · 변환기 켜짐</string>
    <string name="debug_mode_translator_off">%1$s · 변환기 꺼짐</string>
    <string name="debug_preset_label">현재 프리셋</string>
    <string name="debug_preset_description">아래에서 프리셋을 선택하면 저장되고 테스트 샘플이 바로 재생돼요.</string>
    <string name="debug_preset_details">모드: %1$s\n고급 편집 내용은 값이 프리셋과 같아도 사용자 지정으로 저장돼요.</string>
    <string name="debug_preset_problem">문제</string>
    <string name="debug_preset_problem_description">%1$s 문제: %2$s.</string>
    <string name="debug_preset_active">사용 중</string>
    <string name="debug_preset_select">선택</string>
    <string name="debug_live_amplitude_label">실시간 진폭 · %1$s</string>
    <string name="debug_live_amplitude_description">시작 킥과 스무딩이 자리 잡는 과정을 포함해 실시간으로 계산한 기기 진폭이에요.</string>
    <string name="debug_live_amplitude_details">모드: %1$s\n패턴: %2$s\n두 호스트 모터 모두 표시된 입력 비율을 받아요. 최종 출력 비율이 아니에요.</string>
    <string name="debug_stop_label">진동 중지</string>
    <string name="debug_stop_description">실험실 패턴과 모든 연속 기기/컨트롤러 진동 테스트를 중지해요.</string>
    <string name="debug_replay_label">테스트 샘플 다시 재생</string>

    <string name="debug_pattern_details">실시간 진폭: %1$d / 255\n모드: %2$s\n재생 중: %3$s\n입력값은 호스트 모터 비율이며 최종 기기 출력이 아니에요. 다른 패턴을 선택하면 이 패턴을 대체하고, 진동 중지로 멈출 수 있어요.</string>
    <string name="debug_pattern_test_label">테스트</string>
    <string name="debug_pattern_test_description">짧은 탭, 1초 동안의 일정한 럼블, 점점 커지는 램프, 잦아드는 폭발이에요.</string>
    <string name="debug_pattern_steady_25_label">일정 25% · 조용한 엔진</string>
    <string name="debug_pattern_steady_25_description">2초 동안 낮은 엔진 럼블이에요. 두 호스트 모터 모두 25%예요.</string>
    <string name="debug_pattern_steady_50_label">일정 50% · 순항 엔진</string>
    <string name="debug_pattern_steady_50_description">2초 동안 중간 엔진 럼블이에요. 두 호스트 모터 모두 50%예요.</string>
    <string name="debug_pattern_steady_75_label">일정 75% · 거친 지형</string>
    <string name="debug_pattern_steady_75_description">2초 동안 강한 지형 럼블이에요. 두 호스트 모터 모두 75%예요.</string>
    <string name="debug_pattern_steady_100_label">일정 100% · 최대 출력</string>
    <string name="debug_pattern_steady_100_description">2초 동안 최대 호스트 럼블이에요. 두 호스트 모터 모두 100%예요.</string>
    <string name="debug_pattern_ramp_label">상승 · 가속</string>
    <string name="debug_pattern_ramp_description">2초에 걸쳐 두 호스트 모터가 무진동에서 최대 입력까지 올라가요.</string>
    <string name="debug_pattern_tap_30_label">30 ms 탭 · 가벼운 충격</string>
    <string name="debug_pattern_tap_30_description">최대 입력의 30 ms 탭 네 번이 250 ms 간격으로 이어져요.</string>
    <string name="debug_pattern_tap_60_label">60 ms 탭 · 무기 발사</string>
    <string name="debug_pattern_tap_60_description">최대 입력의 60 ms 탭 네 번이 250 ms 간격으로 이어져요.</string>
    <string name="debug_pattern_tap_100_label">100 ms 탭 · 강한 충격</string>
    <string name="debug_pattern_tap_100_description">최대 입력의 100 ms 탭 네 번이 250 ms 간격으로 이어져요.</string>
    <string name="debug_pattern_heartbeat_label">심장 박동 · 두 번씩 맥박</string>
    <string name="debug_pattern_heartbeat_description">심장 박동처럼 최대 입력의 70 ms / 100 ms 맥박 쌍이 네 번 이어져요.</string>
    <string name="debug_pattern_explosion_label">폭발 · 잦아드는 폭음</string>
    <string name="debug_pattern_explosion_description">최대 입력의 폭발이 2초에 걸쳐 잦아들어요.</string>
    <string name="debug_pattern_flutter_label">떨림 · 빠른 기계음</string>
    <string name="debug_pattern_flutter_description">최대 입력의 20 ms 맥박 스무 번이 이어지고, 각각 뒤에 40 ms의 정적이 있어요.</string>

    <string name="debug_advanced_label">고급</string>
    <string name="debug_advanced_description">수동 조절을 표시해요. 값을 바꾸면 프리셋이 사용자 지정으로 바뀌고 현재 패턴이 멈춰요.</string>
    <string name="debug_enabled_label">럼블 변환기 사용</string>
    <string name="debug_enabled_description">끄면 Original 변환을 사용해요. 켜면 이 매개변수를 스트리밍 럼블과 실험실 패턴에 적용해요.</string>
    <string name="debug_gain_label">게인</string>
    <string name="debug_gain_description">전체 럼블 배율로, 50–300%예요. 매개변수를 바꾸면 현재 패턴이 멈춰요.</string>
    <string name="debug_curve_label">커브</string>
    <string name="debug_curve_description">응답 지수: %1$d%% 미만이면 약한 럼블이 강해지고, %1$d%%를 넘으면 부드러워져요.</string>
    <string name="debug_min_label">최소 진폭</string>
    <string name="debug_min_description">0이 아닌 호스트 요청에 대한 최소 출력이에요. 입력이 0이면 계속 조용해요.</string>
    <string name="debug_kick_label">시작 킥</string>
    <string name="debug_kick_description">무진동 상태에서 최대 세기의 킥으로 시작한 뒤 변환된 진폭으로 안정돼요.</string>
    <string name="debug_low_label">저주파 모터 가중치</string>
    <string name="debug_low_description">기기의 단일 진동기에 대한 저주파 호스트 모터의 기여도예요. Original: 80%.</string>
    <string name="debug_high_label">고주파 모터 가중치</string>
    <string name="debug_high_description">기기의 단일 진동기에 대한 고주파 호스트 모터의 기여도예요. Original: 33%.</string>
    <string name="debug_smoothing_label">스무딩</string>
    <string name="debug_smoothing_description">급격한 진폭 변화를 제한해요. 0이면 즉시 반응하고, 값이 높을수록 천천히 안정돼요.</string>
    <string name="debug_reset_label">매개변수를 Original로 초기화</string>
    <string name="debug_reset_description">Original 매개변수를 사용자 지정으로 복원해요. 사용 스위치는 그대로예요.</string>

    <string name="debug_osc_label">화면 컨트롤 미리보기</string>
    <string name="debug_osc_description">스트림 없이 화면 컨트롤을 써 볼 수 있어요. 모든 버튼, 방향 패드, 스틱을 시험해 보세요. 아무것도 전송되지 않아요. 모서리의 톱니바퀴로 스트림에서처럼 레이아웃을 편집해요.</string>

    <string name="debug_no_pads_label">연결된 컨트롤러가 없어요</string>
    <string name="debug_no_pads_description">컨트롤러를 연결하면 바로 여기에 표시돼요. 휴대용 기기의 내장 컨트롤은 하나로 계산해요.</string>
    <string name="debug_pad_description_vibrates">벤더 및 제품 ID %1$s (%2$s). 모션 센서: %3$s. 진동: 지원함, 선택해서 테스트하세요.</string>
    <string name="debug_pad_description_silent">벤더 및 제품 ID %1$s (%2$s). 모션 센서: %3$s. 진동: 지원하지 않음.</string>
    <string name="debug_sensors_unknown">Android 12 미만에서는 알 수 없음</string>
    <string name="debug_sensors_none">보고된 센서 없음</string>
    <string name="debug_sensors_accelerometer">가속도계</string>
    <string name="debug_sensors_gyroscope">자이로스코프</string>
    <string name="debug_sensors_both">가속도계, 자이로스코프</string>
    <string name="debug_pads_continuous_label">컨트롤러 연속 진동</string>
    <string name="debug_pads_continuous_description">진동할 수 있는 모든 컨트롤러가 위의 세기로 계속 진동해요.</string>
    <string name="debug_section_displays">디스플레이</string>
    <string name="debug_display_role_main">메인</string>
    <string name="debug_display_role_built_in">내장</string>
    <string name="debug_display_role_external">외부</string>
    <string name="debug_display_role_virtual">가상</string>
    <string name="debug_display_main_description">기본 디스플레이예요. Delos 화면과, 외부 디스플레이 모드가 옮기지 않는 한 스트림도 여기에 표시돼요.</string>
    <string name="debug_display_built_in_description">이 기기의 일부인 두 번째 패널이에요. Delos는 외부 디스플레이처럼 스트림을 보내지 않아요. 잘못됐다면 디스플레이 설정에서 보조 디스플레이를 바꿔 주세요.</string>
    <string name="debug_display_external_description">이 기기에 연결된 모니터나 TV예요. 외부 디스플레이 모드가 스트림을 표시할 수 있어요. 잘못됐다면 디스플레이 설정에서 보조 디스플레이를 바꿔 주세요.</string>
    <string name="debug_display_virtual_description">오버레이, 가상 또는 비공개 디스플레이예요. Delos는 스트림을 표시하지 않아요.</string>
</resources>
