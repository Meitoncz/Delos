    <string name="title_import_keyboard_layout">키보드 레이아웃 가져오기</string>
    <string name="title_export_keyboard_layout">키보드 레이아웃 내보내기</string>
    <string name="summary_import_keyboard_layout">현재 레이아웃을 덮어써요.</string>
    <string name="summary_export_keyboard_layout">현재 키보드 레이아웃을 내보내요</string>
    <string name="title_manual_enter_bitrate">사용자 지정 비트레이트</string>
    <string name="summary_manual_enter_bitrate">비트레이트를 직접 입력해요.\n슬라이더의 최대 범위를 넘을 수 있어요.</string>
    <string name="dialog_manual_enter_bitrate">비트레이트를 Mbps 단위로 입력해 주세요. 0.5 단위로 반올림돼요.</string>
    <string name="title_custom_refresh_rate">사용자 지정 주사율</string>
    <string name="summary_custom_refresh_rate">주사율을 직접 입력해요. Apollo에서만 지원돼요.</string>
    <string name="dialog_custom_refresh_rate">주사율을 Hz 단위로 입력해 주세요. 소수도 가능해요.</string>
    <string name="title_touchscreen_mode">터치스크린 모드</string>
    <string name="summary_touchscreen_mode">멀티터치/싱글터치/트랙패드/사용 안 함 중에서 선택해요.\n사용 안 함을 선택해도 펜/스타일러스는 사용할 수 있어요.\n외부 디스플레이를 사용할 때는 트랙패드(자연스러움) 모드로 고정돼요.</string>
    <string name="title_checkbox_mouse_local_cursor">로컬 마우스 커서 사용</string>
    <string name="summary_checkbox_mouse_local_cursor">기본적으로 외장 물리 마우스 커서가 캡처돼요. 이 옵션을 켜면 Android 시스템 커서를 표시할 수 있어요</string>
    <string name="title_checkbox_multi_touch_gestures">멀티터치 제스처 사용</string>
    <string name="summary_checkbox_multi_touch_gestures">멀티터치 모드에서 손가락 3개로 탭하면 키보드, 4개로 탭하면 전체 키보드, 5개로 탭하면 빠른 메뉴가 열려요.</string>
    <string name="title_checkbox_enable_perf_overlay_lite">간단 모드</string>
    <string name="summary_checkbox_enable_perf_overlay_lite">상단 가운데에 한 줄로 FPS, 대역폭, 네트워크 및 디코딩 지연, 손실 프레임을 표시해요. 스트림 메뉴의 오버레이 버튼으로 전체, 간단, 끄기를 전환해요.</string>
    <string name="title_virtual_trackpad_settings">가상 트랙패드 설정</string>
    <string name="dialog_custom_resolution">해상도를 설정하고 설정 페이지를 나가면 적용돼요!</string>
    <string name="summary_custom_resolution">x로 구분해서 사용자 지정 해상도를 추가해요. 특이한 해상도는 작동하지 않을 수 있어요.\n예: 1920x1080\n기본 해상도가 아니면 노치 영역을 채우지 않을 수 있어요. 화면 비율이 같다면 직접 늘이기로 설정해 전체 화면을 채울 수 있어요</string>
    <string name="title_custom_resolution">사용자 지정 해상도</string>
    <string name="title_auto_orientation">자동 방향</string>
    <string name="summary_auto_orientation">스트림이 시작될 때 기기의 방향에 맞춰 스트리밍 화면을 표시해요.</string>
    <string name="title_import_special_button">사용자 지정 키 가져오기</string>
    <string name="summary_import_special_button">뒤로 메뉴와 특수 키에서 사용할 수 있어요.\n참고: 가져오면 현재 구성을 덮어쓰므로 미리 백업해 주세요.</string>
    <string name="title_special_key_layout">특수 키 레이아웃</string>
    <string name="title_show_virtual_key">화면에 가상 키 표시</string>
    <string name="summary_show_virtual_key">터치스크린에 가상 특수 키 레이어를 표시해요.\n키 투명도는 위의 가상 게임패드와 공유돼요.</string>
    <string name="title_default_layout_scheme">기본 레이아웃 프로필</string>
    <string name="summary_default_layout_scheme">각 레이아웃 프로필은 처음에는 모두 같고(keyboards.json 파일을 기준으로 생성), 직접 삭제하거나 조정할 수 있어요</string>
    <string name="summary_vibrate_keyboard">화면 버튼을 누르면 휴대폰 진동 모터가 작동해요. 가상 게임패드 버튼에도 사용할 수 있는 옵션이에요.</string>
    <string name="title_square_buttons">일반 버튼을 사각형으로</string>
    <string name="summary_square_buttons">가상 버튼 모양을 사각형으로 해요. 기본값은 원형이에요.</string>
    <string name="title_reset_keyboard_layout">가상 키보드 레이아웃 초기화</string>
    <string name="summary_reset_keyboard_layout">특수 키 레이아웃을 초기화해요 (기본으로 선택된 레이아웃 구성을 다시 설정)</string>
    <string name="title_joyconfix">Switch JoyCon 호환</string>
    <string name="summary_joyconfix">JoyCon을 사용할 수 없거나 키 인식에 문제가 있으면 이 기능을 켜 보세요. Android 10 이상에 맞춰져 있어요</string>
    <string name="title_keyboard_opacity">가상 전체 키보드 투명도</string>
    <string name="title_onscreen_keyboard_autofit">가상 전체 키보드 자동 맞춤 끄기</string>
    <string name="title_onscreen_keyboard_height">가상 전체 키보드 높이</string>
    <string name="title_onscreen_keyboard_width">가상 전체 키보드 너비</string>
    <string name="title_onscreen_keyboard_align_mode">가상 전체 키보드 정렬 모드</string>
    <string name="summary_onscreen_keyboard_height">가상 전체 키보드의 높이를 조절해요</string>
    <string name="summary_onscreen_keyboard_autofit">키보드의 크기와 위치를 자동으로 조절하지 않고 사용자 지정 크기를 허용해요</string>
    <string name="summary_onscreen_keyboard_width">가상 전체 키보드의 너비를 조절해요</string>
    <string name="summary_onscreen_keyboard_align_mode">가상 전체 키보드를 뷰포트에 맞춰 정렬하는 방식이에요</string>
    <string name="title_free_analog_stick">프리 아날로그 스틱</string>
    <string name="summary_free_analog_stick">가상 게임패드 왼쪽/오른쪽 스틱의 중심점이 고정되지 않고 일정한 이동 범위 안에서 자유롭게 움직여요.</string>
    <string name="summary_free_analog_stick_opacity">기본적으로 스틱이 움직일 때만 배경이 표시돼요. 마음에 들지 않으면 투명도를 조절할 수 있어요.</string>
    <string name="title_free_analog_stick_opacity">프리 아날로그 스틱 배경 투명도</string>
    <string name="title_fullexdisplay_mode">완전 외부 디스플레이 모드</string>
    <string name="summary_fullexdisplay_mode">주사율과 해상도를 자동으로 맞춰 보조 화면을 완전한 몰입 모드로 사용해요. 이 모드에서는 수동 설정이 적용되지 않아요. 일부 기기나 디스플레이에서는 작동하지 않을 수 있어요.</string>
    <string name="title_top_center_display">상단 가운데에 표시</string>
    <string name="summary_top_center_display">해상도가 기본값이 아닐 때 스트리밍 화면을 가운데가 아닌 화면 상단에 맞춰 정렬해요.</string>
    <string name="title_touch_sensitivity">터치스크린 감도</string>
    <string name="summary_touch_sensitivity">켜면 터치 감도를 직접 조절할 수 있어요.</string>
    <string name="title_global_touch_sensitivity">터치스크린 감도 전체 적용</string>
    <string name="summary_global_touch_sensitivity">기본값은 꺼짐이며 화면 오른쪽 절반에서만 적용돼요(원신 플레이에 적합). 켜면 화면 전체에 적용돼요.</string>
    <string name="title_auto_touch_sensitivity">터치 좌표가 경계를 넘으면 화면 중앙으로 자동 복귀</string>
    <string name="summary_auto_touch_sensitivity">보통 감도가 높으면 조금만 밀어도 경계를 넘어서 더 움직이지 못해요. 이럴 때 이 옵션을 선택하세요.</string>
    <string name="title_touch_sensitivity_x">화면 감도 조절 X축</string>
    <string name="summary_touch_sensitivity_x">멀티터치 모드에서 일부 게임은 감도 조절이 맞지 않을 수 있어요. 이 옵션으로 시야 감도를 바꿀 수 있어요.</string>
    <string name="title_touch_sensitivity_y">화면 감도 조절 Y축</string>
    <string name="summary_touch_sensitivity_y">멀티터치 모드에서 일부 게임은 감도 조절이 맞지 않을 수 있어요. 이 옵션으로 시야 감도를 바꿀 수 있어요.</string>
    <string name="title_debug_info">디버그 정보</string>
    <string name="summary_debug_info">게임패드 진동 등을 테스트해요.</string>
    <string name="title_touchpad_sensitivity_x">터치패드 감도 X축</string>
    <string name="summary_touchpad_sensitivity_x">마우스 터치패드 모드와 가상 특수 버튼 터치패드 제어에 사용돼요.\n둘은 감도 값을 공유하지만 감도 체감은 다를 수 있어요.\n둘을 함께 쓰는 사람이 있을까요?</string>
    <string name="title_touchpad_sensitivity_y">터치패드 감도 Y축</string>
    <string name="summary_touchpad_sensitivity_y">마우스 터치패드 모드와 가상 특수 버튼 터치패드 제어에 사용돼요.\n둘은 감도 값을 공유하지만 감도 체감은 다를 수 있어요.\n둘을 함께 쓰는 사람이 있을까요?</string>
    <string name="title_device_rumble">기기 진동 강제</string>
    <string name="summary_device_rumble">연결된 게임패드의 진동이 마음에 들지 않으면 이 옵션을 켜 보세요.\n내장 Delos USB 드라이버를 강제로 사용하는 경우에는 적용되지 않아요</string>
    <string name="title_clear_default_special_button">기본 특수 키 끄기</string>
    <string name="summary_clear_default_special_button">뒤로 메뉴의 기본 명령이 필요 없다고 느껴지면 끄고 가져온 키를 사용할 수 있어요.</string>
    <string name="title_trackpad_sensitivity_x">트랙패드 감도 X</string>
    <string name="summary_trackpad_sensitivity_x">트랙패드의 X축 감도예요. 음수로 하면 방향이 반전돼요</string>
    <string name="title_trackpad_sensitivity_y">트랙패드 감도 Y</string>
    <string name="summary_trackpad_sensitivity_y">트랙패드의 Y축 감도예요. 음수로 하면 방향이 반전돼요</string>
    <string name="title_trackpad_drag_drop_vibration">트랙패드 드래그 앤 드롭 진동 사용</string>
    <string name="summary_trackpad_drag_drop_vibration">삼성 트랙패드 기기에서 드래그 앤 드롭 동작에 진동 피드백을 사용해요.</string>
    <string name="title_trackpad_drag_drop_threshold">트랙패드 드래그 앤 드롭 활성화 길게 누르기 시간</string>
    <string name="summary_trackpad_drag_drop_threshold">삼성 기기에서 드래그 앤 드롭이 시작되기 전에 트랙패드를 누르고 있어야 하는 시간을 설정해요.</string>
    <string name="title_trackpad_swap_axis">트랙패드 입력의 X축과 Y축 교체</string>
    <string name="summary_trackpad_swap_axis">일부 기기에서는 트랙패드 입력의 축이 회전되어 있을 수 있어요. 이 옵션을 켜면 도움이 될 수 있어요.</string>
    <string name="title_checkbox_force_qwerty">QWERTY 레이아웃 강제</string>
    <string name="summary_checkbox_force_qwerty">QWERTY 키보드 레이아웃을 강제로 사용해요.\nGFE에 필요해요.\n다른 키보드 레이아웃을 쓰려면 꺼 주세요.</string>
    <string name="title_checkbox_right_alt_as_meta">오른쪽 Alt를 Command로 사용 (Mac)</string>
    <string name="summary_right_alt_as_meta">Mac 스트리밍에서 오른쪽 Alt를 Command 키로 바꿔요. 오른쪽 Alt+키 조합은 모두 Command+키가 돼요. 왼쪽 Alt는 그대로예요.</string>
    <string name="title_checkbox_ignore_synth_events">합성 이벤트 무시</string>
    <string name="summary_ignore_synth_events">Android 시스템이 보내는 합성 이벤트를 무시해요. 일부 기기에서 마우스 클릭이 예상치 못한 다른 키를 누르는 문제가 해결될 수 있어요.\n이 옵션을 켜면 시스템 소프트 키보드가 작동하지 않아요.</string>
    <string name="title_smart_clipboard_sync">스마트 클립보드 동기화</string>
    <string name="summary_smart_clipboard_sync">스트림이 시작되거나 재개될 때 클립보드 내용을 서버로 자동 업로드하고, 포커스를 잃으면 서버에서 클립보드를 내려받아요 (Vibepollo 또는 Apollo 필요)</string>
    <string name="title_smart_clipboard_sync_toast">클립보드 동기화 알림</string>
    <string name="summary_smart_clipboard_sync_toast">클립보드 동기화 결과를 알림으로 표시해요</string>
    <string name="title_hide_clipboard_content">클립보드 내용 숨기기</string>
    <string name="summary_hide_clipboard_content">원격 클립보드를 민감한 정보로 표시해요</string>
    <string name="title_settings_misc">기타</string>
    <string name="perf_overlay_lite_bandwidth">대역폭</string>
    <string name="perf_overlay_lite_network_decoding_delay">네트워크/디코딩 지연</string>
    <string name="perf_overlay_lite_packet_loss">패킷 손실</string>
    <string name="wrong_import_format">가져오기 형식이 올바르지 않아요. 확인해 주세요!</string>
    <string name="title_checkbox_gamepad_enable_battery_report">게임패드 배터리 상태 보고 사용</string>
    <string name="summary_checkbox_gamepad_enable_battery_report">가능하면 게임패드 배터리 상태를 보고해요.\n터치스크린/터치패드/스타일러스/마우스 입력이 가끔 끊기면 이 옵션을 꺼 보세요.</string>
    <string name="title_checkbox_enforce_display_mode">디스플레이 모드 강제</string>
    <string name="summary_checkbox_enforce_display_mode">서피스가 최적의 디스플레이 모드를 사용하도록 강제해요.\n일부 시스템(예: ColorOS)에서 주사율/해상도를 제대로 설정하려면 필요해요.\n버그가 생길 수 있으니 ChromeCast 4K에서는 켜지 마세요.</string>
    <string name="title_checkbox_ultra_low_latency">초저지연</string>
    <string name="summary_checkbox_ultra_low_latency">Snapdragon 8 Gen 2, 8(s) Gen 3, 8 Elite 및 MediaTek 기기에서만 작동해요.</string>
    <string name="title_checkbox_use_virtual_display">가상 디스플레이 사용</string>
    <string name="summary_checkbox_use_virtual_display">기본적으로 가상 디스플레이를 사용해요.\n가상 디스플레이는 클라이언트 쪽 해상도와 프레임 레이트 설정에 자동으로 맞춰져서 끊김 없는 스트리밍을 제공해요.\n호스트 스트리밍 소프트웨어로 Apollo가 필요해요.</string>
    <string name="title_checkbox_enable_sticky_modifier_key_virtual_keyboard">고정 수정 키</string>
    <string name="summary_checkbox_enable_sticky_modifier_key_virtual_keyboard">가상 전체 키보드와 사용자 지정 화면 키보드에서 고정 수정 키를 사용해요.</string>
    <string name="mouse_mode_multi_touch">멀티터치</string>
    <string name="mouse_mode_absolute_touch">절대 터치</string>
    <string name="mouse_mode_track_pad_natural">트랙패드 (자연스러움/두 번 탭하여 드래그)</string>
    <string name="mouse_mode_track_pad_gaming">트랙패드 (게이밍/길게 눌러 드래그)</string>
    <string name="mouse_mode_disabled">사용 안 함</string>
    <string name="mouse_mode_absolute_touch_swapped">절대 터치 (좌/우 클릭 바꿈)</string>
    <string name="keyboard_layout_set_1">프로필 1</string>
    <string name="vdisplay_not_ready">서버에서 가상 디스플레이 드라이버가 준비되지 않았어요. SudoVDA 드라이버가 설치되어 있고 켜져 있는지 확인해 주세요.</string>
    <string name="vdisplay_not_supported"><![CDATA[이 서버는 가상 디스플레이를 지원하지 않아요. 호스트 스트리밍 소프트웨어로 <a href=\"https://github.com/Nonary/Vibepollo\">Vibepollo</a> 또는 <a href=\"https://github.com/ClassicOldSong/Apollo\">Apollo</a>를 사용해 주세요.]]></string>
    <string name="clipboard_sync_unsupported">이 서버는 클립보드 동기화를 지원하지 않아요. 서버를 최신 버전의 Apollo로 설치하거나 업그레이드해 주세요.</string>
