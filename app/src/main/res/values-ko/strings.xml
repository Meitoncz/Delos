    <string name="category_advanced_settings">고급 설정</string>
    <string name="title_unlock_fps">가능한 모든 프레임 레이트 잠금 해제</string>
    <string name="summary_unlock_fps">90 또는 120 FPS 스트리밍은 고성능 기기에서 지연을 줄일 수 있지만, 지원하지 못하는 기기에서는 끊김이나 불안정이 생길 수 있어요</string>
    <string name="title_checkbox_reduce_refresh_rate">주사율 낮추기 허용</string>
    <string name="summary_checkbox_reduce_refresh_rate">디스플레이 주사율을 낮추면 전력을 아낄 수 있지만 영상 지연이 조금 늘어나요</string>
    <string name="title_checkbox_disable_warnings">경고 메시지 끄기</string>
    <string name="summary_checkbox_disable_warnings">스트리밍 중 화면에 표시되는 연결 경고 메시지를 꺼요</string>
    <string name="title_video_format">비디오 코덱</string>
    <string name="summary_video_format">기기가 지원하면 최신 코덱으로 비디오 대역폭을 줄일 수 있어요. 호스트 소프트웨어나 GPU가 지원하지 않으면 코덱 선택이 무시될 수 있어요.</string>
    <string name="title_enable_hdr">HDR 사용</string>
    <string name="summary_enable_hdr">게임과 PC GPU가 지원하면 HDR로 스트리밍해요. HDR에는 HEVC Main 10 인코딩을 지원하는 GPU가 필요해요. HDR이 보이는 모습은 이 기기의 디스플레이에 따라 달라요.</string>
    <string name="title_full_range">풀 레인지 비디오 강제</string>
    <string name="summary_full_range">기기가 풀 레인지 비디오를 제대로 표시하지 못하면 밝은 영역과 어두운 영역의 디테일이 사라져요.</string>
    <string name="title_prevent_packet_loss">Wi-Fi 연결 유지</string>
    <string name="summary_prevent_packet_loss">스트리밍 중 작은 패킷을 보내 Wi-Fi가 절전 모드로 들어가지 않게 도와요. 원인 모를 패킷 손실이 있는 기기에서 도움이 될 수 있어요.</string>
    <string name="title_enable_perf_overlay">스트리밍 중 성능 통계 표시</string>
    <string name="summary_enable_perf_overlay">스트리밍 중 실시간 스트림 성능 정보를 표시해요</string>
    <string name="title_special_key_help">사용자 지정 키 도움말</string>
    <string name="summary_special_key_help">사용자 지정 특수 키를 설정하는 방법을 안내해요</string>
    <string name="toast_controller_type_changed">모션 센서 에뮬레이션 때문에 게임패드 유형이 바뀔 수 있어요</string>
