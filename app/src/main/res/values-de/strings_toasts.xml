    <string name="toast_kind_error">FEHLER</string>
    <string name="toast_kind_action">RÜCKGÄNGIG</string>
    <!-- Screen-reader text of a toast. %1$s: the kind word, %2$s: the message -->
    <string name="toast_description">%1$s. %2$s</string>
