#version 450
// Video-adapted SGSR 2 reconstruction for PyroWave. Motion comes from decoded frames rather than an
// engine, so history is accepted only where forward/backward flow and local colour bounds agree.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D u_y;
layout(set = 0, binding = 1) uniform sampler2D u_cb;
layout(set = 0, binding = 2) uniform sampler2D u_cr;
layout(set = 0, binding = 3) uniform sampler2D u_history;
layout(set = 0, binding = 4) uniform sampler2D u_backward;
layout(set = 0, binding = 5) uniform sampler2D u_forward;
layout(set = 0, binding = 6, rgba16f) writeonly uniform image2D u_output;
layout(push_constant) uniform Params {
    ivec2 inputSize;
    ivec2 outputSize;
    ivec2 flowSize;
    int reset;
    int fullRange;
    int matrix;
    int sixteenBit;
} p;

vec3 rgbToYCoCg(vec3 c) { return vec3(c.r*.25+c.g*.5+c.b*.25,c.r*.5-c.b*.5,-c.r*.25+c.g*.5-c.b*.25); }
vec3 yCoCgToRgb(vec3 c) { return vec3(c.x+c.y-c.z,c.x+c.z,c.x-c.y-c.z); }
float lanczos(float distance2) { float y=clamp(distance2*.25,0.0,1.0)-1.0; return (.75*y+y*y)*y*y; }
vec3 source(ivec2 q) {
    q=clamp(q,ivec2(0),p.inputSize-1);
    vec2 uv=(vec2(q)+.5)/vec2(p.inputSize);
    float unit=p.sixteenBit!=0?256.0/65535.0:1.0/255.0;
    float mid=p.sixteenBit!=0?.5:128.0/255.0;
    float y=texelFetch(u_y,q,0).r;
    float cb=texture(u_cb,uv).r-mid,cr=texture(u_cr,uv).r-mid;
    if(p.fullRange==0){y=(y-16.0*unit)/(219.0*unit);cb/=224.0*unit;cr/=224.0*unit;}
    vec2 k=p.matrix==0?vec2(.299,.114):(p.matrix==2?vec2(.2627,.0593):vec2(.2126,.0722));
    float kg=1.0-k.x-k.y;
    return clamp(vec3(y+2.0*(1.0-k.x)*cr,
        y-(2.0*k.y*(1.0-k.y)/kg)*cb-(2.0*k.x*(1.0-k.x)/kg)*cr,
        y+2.0*(1.0-k.y)*cb),0.0,1.0);
}

void main() {
    ivec2 outPos=ivec2(gl_GlobalInvocationID.xy);
    if(any(greaterThanEqual(outPos,p.outputSize))) return;
    vec2 uv=(vec2(outPos)+.5)/vec2(p.outputSize);
    vec2 sourcePos=uv*vec2(p.inputSize)-.5;
    ivec2 base=ivec2(floor(sourcePos));
    vec3 reconstructed=vec3(0.0), localMin=vec3(1e10), localMax=vec3(-1e10);
    vec3 ycMin=vec3(1e10),ycMax=vec3(-1e10);
    float weightSum=0.0;
    for(int y=-1;y<=1;y++) for(int x=-1;x<=1;x++) {
        ivec2 q=base+ivec2(x,y); vec3 c=source(q);
        float w=lanczos(dot(vec2(q)-sourcePos,vec2(q)-sourcePos));
        reconstructed+=c*w;weightSum+=w;localMin=min(localMin,c);localMax=max(localMax,c);
        vec3 yc=rgbToYCoCg(c);ycMin=min(ycMin,yc);ycMax=max(ycMax,yc);
    }
    reconstructed=abs(weightSum)>1e-5?clamp(reconstructed/weightSum,localMin,localMax):source(base);
    vec2 flowUv=((uv*vec2(p.inputSize)-.5)/8.0)/vec2(p.flowSize);
    vec4 backward=texture(u_backward,flowUv);
    vec2 previousUv=uv+backward.xy/vec2(p.inputSize);
    vec4 forward=texture(u_forward,((previousUv*vec2(p.inputSize)-.5)/8.0)/vec2(p.flowSize));
    float consistency=length(backward.xy+forward.xy);
    float confidence=min(backward.w,forward.w)*exp(-consistency*1.5);
    if(any(lessThan(previousUv,vec2(0)))||any(greaterThan(previousUv,vec2(1)))) confidence=0.0;
    vec3 history=texture(u_history,clamp(previousUv,vec2(0),vec2(1))).rgb;
    history=yCoCgToRgb(clamp(rgbToYCoCg(history),ycMin,ycMax));
    float residual=abs(dot(reconstructed-history,vec3(.2126,.7152,.0722)));
    float reactive=max(smoothstep(.025,.12,residual),1.0-confidence);
    float currentWeight=max(p.reset!=0?1.0:0.12,reactive);
    imageStore(u_output,outPos,vec4(mix(history,reconstructed,currentWeight),1.0));
}
