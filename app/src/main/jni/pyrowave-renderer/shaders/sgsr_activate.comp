// Video-adapted SGSR 2 Activate (licence: assets/licenses/sgsr.txt), matching assets/sgsr/video_activate.comp.
// Uses decoded luma rather than engine depth: disocclusion, inconsistent flow and
// source-frame changes activate fresh reconstruction before history is accumulated.
layout(local_size_x=8,local_size_y=8) in;
layout(set=0,binding=0) uniform sampler2D u_currentLuma;
layout(set=0,binding=1) uniform sampler2D u_previousLuma;
layout(set=0,binding=2) uniform sampler2D u_backward;
layout(set=0,binding=3) uniform sampler2D u_forward;
layout(set=0,binding=4,rgba16f) writeonly uniform image2D u_reactive;
layout(push_constant) uniform Params {
    ivec2 inputSize;
    ivec2 outputSize;
    ivec2 flowSize;
    int reset;
    int fullRange;
    int matrix;
    int sixteenBit;
    int mode;
    int padding;
} p;
vec2 flowUv(vec2 uv) {
    return ((uv*vec2(p.inputSize)-.5)/8.0)/vec2(p.flowSize);
}
void main() {
    ivec2 pos=ivec2(gl_GlobalInvocationID.xy);
    if(any(greaterThanEqual(pos,p.inputSize))) return;
    if(p.reset!=0) { imageStore(u_reactive,pos,vec4(1.0));return; }
    vec2 uv=(vec2(pos)+.5)/vec2(p.inputSize);
    vec4 backward=texture(u_backward,flowUv(uv));
    vec2 previousUv=uv+backward.xy/vec2(p.inputSize);
    vec4 forward=texture(u_forward,flowUv(clamp(previousUv,vec2(0),vec2(1))));
    float consistency=length(backward.xy+forward.xy);
    float current=texelFetch(u_currentLuma,pos,0).r;
    float previous=texture(u_previousLuma,clamp(previousUv,vec2(0),vec2(1))).r;
    float residual=abs(current-previous);
    float reactive=max(1.0-min(backward.w,forward.w),smoothstep(.75,2.5,consistency));
    reactive=max(reactive,smoothstep(.025,.12,residual));
    if(any(lessThan(previousUv,vec2(0)))||any(greaterThan(previousUv,vec2(1)))) reactive=1.0;
    imageStore(u_reactive,pos,vec4(clamp(reactive,0.0,1.0)));
}
