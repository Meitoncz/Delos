#version 450
// Arrival-only FP16, gamma/PQ-encoded RGB. Matches planar_csc.frag; no tone mapping or CPU copy.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D u_y;
layout(set = 0, binding = 1) uniform sampler2D u_cb;
layout(set = 0, binding = 2) uniform sampler2D u_cr;
layout(set = 0, binding = 3, rgba16f) writeonly uniform image2D u_rgb;
layout(push_constant) uniform Csc { int fullRange; int matrix; int sixteenBit; } csc;
void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_rgb);
    if (any(greaterThanEqual(pixel, size))) return;
    vec2 uv = (vec2(pixel) + .5) / vec2(size);
    float unit = csc.sixteenBit != 0 ? 256.0 / 65535.0 : 1.0 / 255.0;
    float mid = csc.sixteenBit != 0 ? .5 : 128.0 / 255.0;
    float y = textureLod(u_y, uv, 0).r;
    float cb = textureLod(u_cb, uv, 0).r - mid;
    float cr = textureLod(u_cr, uv, 0).r - mid;
    if (csc.fullRange == 0) {
        y = (y - 16.0 * unit) / (219.0 * unit);
        cb /= 224.0 * unit;
        cr /= 224.0 * unit;
    }
    vec2 k = csc.matrix == 0 ? vec2(.299, .114) : (csc.matrix == 2 ? vec2(.2627, .0593) : vec2(.2126, .0722));
    float kg = 1.0 - k.x - k.y;
    vec3 rgb = vec3(y + 2.0 * (1.0-k.x) * cr,
        y - (2.0*k.y*(1.0-k.y)/kg)*cb - (2.0*k.x*(1.0-k.x)/kg)*cr,
        y + 2.0 * (1.0-k.y) * cb);
    imageStore(u_rgb, pixel, vec4(clamp(rgb, 0.0, 1.0), 1));
}
